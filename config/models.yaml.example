// config/models.yaml.example
# Fleet configuration for dsh-smart-router
# Copy to config/models.yaml and customize

models:
  # Zero-tier (local) models
  - id: local-gemma-4-7b
    tier: zero-tier
    provider: lmstudio
    endpoint: http://localhost:1234/v1
    capabilities:
      reasoning: 0.4
      code_gen: 0.6
      tool_use: 0.3
      vision: false
      function_calling: false
      json_mode: true
    pricing:
      registry_key: "local/lmstudio"
      fallback_cost_per_1m: 0.0

  - id: local-qwen-3.5
    tier: zero-tier
    provider: ollama
    endpoint: http://localhost:11434
    capabilities:
      reasoning: 0.45
      code_gen: 0.65
      tool_use: 0.35
      vision: false
      function_calling: false
      json_mode: true
    pricing:
      registry_key: "local/ollama"
      fallback_cost_per_1m: 0.0

  # Economical-cloud models
