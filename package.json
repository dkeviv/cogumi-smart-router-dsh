{
  "name": "@dkeviv/cogumi-smart-router-dsh",
  "version": "0.1.0",
  "description": "Smart router plugin for DeepSeek Harness (DSH) - uses a local LLM to intelligently route requests to optimal models",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cogumi",
    "smart-router",
    "llm",
    "routing",
    "cordis",
    "plugin"
  ],
  "author": "dkeviv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dkeviv/smart-router-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/dkeviv/smart-router-dsh/issues"
  },
  "homepage": "https://github.com/dkeviv/smart-router-dsh#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "aho-corasick": "^0.1.2",
    "onnxruntime-node": "^1.31.1",
    "sql.js": "^1.10.0",
    "tiktoken": "^1.0.12",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}